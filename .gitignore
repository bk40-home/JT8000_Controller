# JT8000_Controller - files git must never pick up (Kris 5 Nov).
# NOTE: .gitignore only stops NEW files being added. Anything already committed (the build/ folder was
# committed in f24ce7e) stays tracked until it is removed from the index once with:
#     git rm -r --cached build

# CMake + Visual Studio build output: regenerated by cmake / build_release.bat, machine-specific, large binaries
/build/
/out/
.vs/
*.user

# Build logs written by build_release.bat
build_log*.txt

# Local working backups (_backup_<change>/) and stray archives
/_backup_*/
*.zip

# OS clutter
Thumbs.db
.DS_Store
