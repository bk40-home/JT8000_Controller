/* ==========================================================================
 * jt8000_v2.rcss - JT-8000 skin v2 override sheet (generated by gen_skin_v2.py)
 *
 * Linked AFTER jt8000.rcss, so equal-specificity rules here win. Kept
 * deliberately small and inside the renderer's budget: solid fills, borders,
 * text, image decorators. It NEVER sets `display`, so view switching stays
 * exactly as defined in jt8000.rcss. Remove the <link> line in jt8000.rml to
 * roll back to the old look.
 * ========================================================================== */

/* Chassis: one flat background, painted from the same geometry as the RML.
 * The old per-view band strips carried baked panel art from an earlier
 * layout - that is one source of the "shifting borders", so the band
 * element is collapsed to zero size (element kept, nothing drawn). */
body  { decorator: image(bg_v2.png); }
.band { width: 0dp; height: 0dp; }

/* Panels are live boxes now, so the frame always matches the controls. */
.secbox
{
	decorator: none;
	background-color: #161a20ff;
	border-width: 2dp;
	border-color: #2b323cff;
}

/* Title bar across the top of each panel, orange accent on the left. */
.sectitle
{
	height: 64dp;
	line-height: 64dp;
	padding-left: 18dp;
	font-size: 34dp;
	font-weight: bold;
	color: #f2f4f7ff;
	background-color: #1e242cff;
	border-left-width: 6dp;
	border-left-color: #e8761aff;
}

/* Control legends: larger and bold so they survive the ~0.6x window scale. */
.legend
{
	height: 44dp;
	line-height: 44dp;
	font-size: 30dp;
	font-weight: bold;
	color: #c9d1dbff;
}
.shiftalt { color: #ff8a5cff; }

/* Combo value text, vertically centred in the 56 dp box. */
.combo
{
	font-size: 30dp;
	line-height: 56dp;
	color: #ffb35cff;
}

/* Header: captions centred by line-height (set per element in the RML),
 * the lit state is a flat orange plate drawn UNDER the caption. */
/* .shiftcap is left to jt8000.rcss: it is dim until SHIFT latches, then lit. */
.btncap   { font-size: 30dp; font-weight: bold; color: #e6e9eeff; }
.layerlit { decorator: none; background-color: #d26a14ff; }

/* Step grids: same frame language as the panels. */
.stepgrid
{
	background-color: #0b0d10ff;
	border-width: 2dp;
	border-color: #3a424fff;
}
