	<div class="legend v-bass" style="left:920dp; top:1752dp; width:152dp; text-align:left;">DIRECTION</div>
	<combo class="combo v-bass" param="bass.direction" key="bass.direction" default="0.0" options="Fwd, Rev, PingPong, Random" index="0" style="left:920dp; top:1796dp; width:152dp; height:56dp;"/>
