	<combo class="combo v-main v-shift v-reverb v-seq v-arp v-setup" param="va_type" key="filter.va_type" default="0.0" options="SVF LP2, SVF HP2, SVF BP2, SVF NOTCH, SVF AP, Moog LP4, Moog LP2, Moog BP2, Diode LP4, Korg35 LP, Korg35 HP, TPT1 LP, TPT1 HP, MoogDV LP4, MoogDV LP2, MoogDV HP4, MoogDV BP" index="0" style="left:2975dp; top:1058dp; width:216dp; height:40dp;"/>
	<combo class="combo v-main v-shift v-reverb v-seq v-arp v-setup" param="flt_xp" key="filter.obxa_xpander_mode" default="0.0" options="LP4, LP3, LP2, LP1, HP3, HP2, HP1, BP4, BP2, N2, PH3, HP2+LP1, HP3+LP1, N2+LP1, PH3+LP1" index="0" style="left:3238dp; top:1058dp; width:170dp; height:40dp;"/>

	<!-- Amp Envelope -->
	<fader class="fader v-main v-shift v-reverb v-seq v-arp v-setup" param="amp_a" key="env_amp.attack" default="0.0" style="left:217dp; top:1284dp; width:23dp; height:255dp;">
		<div class="thumb"/>
	</fader>
	<fader class="fader v-main v-shift v-reverb v-seq v-arp v-setup" param="amp_d" key="env_amp.decay" default="0.0094" style="left:305dp; top:1284dp; width:23dp; height:255dp;">
		<div class="thumb"/>
	</fader>
	<fader class="fader v-main v-shift v-reverb v-seq v-arp v-setup" param="amp_s" key="env_amp.sustain" default="1.0" style="left:394dp; top:1284dp; width:23dp; height:255dp;">
		<div class="thumb"/>
	</fader>
	<fader class="fader v-main v-shift v-reverb v-seq v-arp v-setup" param="amp_r" key="env_amp.release" default="0.0003" style="left:482dp; top:1284dp; width:23dp; height:255dp;">
		<div class="thumb"/>
	</fader>

	<!-- Filter Envelope -->
	<fader class="fader v-main v-shift v-reverb v-seq v-arp v-setup" param="fe_a" key="env_filter.attack" default="0.0" style="left:790dp; top:1284dp; width:23dp; height:255dp;">
		<div class="thumb"/>
	</fader>
	<fader class="fader v-main v-shift v-reverb v-seq v-arp v-setup" param="fe_d" key="env_filter.decay" default="0.0094" style="left:878dp; top:1284dp; width:23dp; height:255dp;">
		<div class="thumb"/>
	</fader>
	<fader class="fader v-main v-shift v-reverb v-seq v-arp v-setup" param="fe_s" key="env_filter.sustain" default="0.0" style="left:967dp; top:1284dp; width:23dp; height:255dp;">
		<div class="thumb"/>
	</fader>
	<fader class="fader v-main v-shift v-reverb v-seq v-arp v-setup" param="fe_r" key="env_filter.release" default="0.0003" style="left:1055dp; top:1284dp; width:23dp; height:255dp;">
		<div class="thumb"/>
	</fader>

	<!-- Pitch Envelope -->
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="pe_depth" key="env_pitch.depth" default="0.5" style="left:1344dp; top:1314dp; width:144dp; height:144dp;"/>
	<fader class="fader v-main v-shift v-reverb v-seq v-arp v-setup" param="pe_a" key="env_pitch.attack" default="0.0" style="left:1533dp; top:1284dp; width:23dp; height:255dp;">
		<div class="thumb"/>
	</fader>
	<fader class="fader v-main v-shift v-reverb v-seq v-arp v-setup" param="pe_d" key="env_pitch.decay" default="0.0094" style="left:1621dp; top:1284dp; width:23dp; height:255dp;">
		<div class="thumb"/>
	</fader>
	<fader class="fader v-main v-shift v-reverb v-seq v-arp v-setup" param="pe_s" key="env_pitch.sustain" default="0.0" style="left:1710dp; top:1284dp; width:23dp; height:255dp;">
		<div class="thumb"/>
	</fader>
	<fader class="fader v-main v-shift v-reverb v-seq v-arp v-setup" param="pe_r" key="env_pitch.release" default="0.0003" style="left:1798dp; top:1284dp; width:23dp; height:255dp;">
		<div class="thumb"/>
	</fader>

	<!-- LFO 1 -->
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="l1_freq" key="lfo1.freq" default="0.0" style="left:1917dp; top:1314dp; width:144dp; height:144dp;"/>
	<combo class="combo v-main v-shift v-reverb v-seq v-arp v-setup" param="l1_wave" key="lfo1.waveform" default="0.0" options="SIN, TRI, SAW, SQR, S&amp;H, NOISE" index="0" style="left:2087dp; top:1314dp; width:144dp; height:40dp;"/>
	<combo class="combo v-main v-shift v-reverb v-seq v-arp v-setup" param="l1_sync" key="lfo1.sync" default="0.0" options="Free, 4 Bars, 2 Bars, 1 Bar, 1/2, 1/4, 1/8, 1/16, 1/32, 1/4T, 1/8T, 1/16T" index="0" style="left:2278dp; top:1314dp; width:143dp; height:40dp;"/>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="l1_p_dep" key="lfo1.pitch_depth" default="0.0" style="left:1917dp; top:1570dp; width:144dp; height:144dp;"/>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="l1_f_dep" key="lfo1.filter_depth" default="0.0" style="left:2087dp; top:1570dp; width:144dp; height:144dp;"/>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="l1_w_dep" key="lfo1.pwm_depth" default="0.0" style="left:2257dp; top:1570dp; width:144dp; height:144dp;"/>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="l1_a_dep" key="lfo1.amp_depth" default="0.0" style="left:2427dp; top:1570dp; width:144dp; height:144dp;"/>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="l1_delay" key="lfo1.delay" default="0.0" style="left:2597dp; top:1570dp; width:144dp; height:144dp;"/>

	<!-- LFO 2 -->
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="l2_freq" key="lfo2.freq" default="0.0" style="left:2817dp; top:1314dp; width:144dp; height:144dp;"/>
	<combo class="combo v-main v-shift v-reverb v-seq v-arp v-setup" param="l2_wave" key="lfo2.waveform" default="0.0" options="SIN, TRI, SAW, SQR, S&amp;H, NOISE" index="0" style="left:2987dp; top:1314dp; width:144dp; height:40dp;"/>
	<combo class="combo v-main v-shift v-reverb v-seq v-arp v-setup" param="l2_sync" key="lfo2.sync" default="0.0" options="Free, 4 Bars, 2 Bars, 1 Bar, 1/2, 1/4, 1/8, 1/16, 1/32, 1/4T, 1/8T, 1/16T" index="0" style="left:3178dp; top:1314dp; width:143dp; height:40dp;"/>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="l2_p_dep" key="lfo2.pitch_depth" default="0.0" style="left:2817dp; top:1570dp; width:144dp; height:144dp;"/>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="l2_f_dep" key="lfo2.filter_depth" default="0.0" style="left:2987dp; top:1570dp; width:144dp; height:144dp;"/>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="l2_w_dep" key="lfo2.pwm_depth" default="0.0" style="left:3157dp; top:1570dp; width:144dp; height:144dp;"/>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="l2_a_dep" key="lfo2.amp_depth" default="0.0" style="left:3327dp; top:1570dp; width:144dp; height:144dp;"/>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="l2_delay" key="lfo2.delay" default="0.0" style="left:3497dp; top:1570dp; width:144dp; height:144dp;"/>

	<!-- EQ & Drive -->
	<knob class="knob v-main v-shift" param="fx_bass" key="fx.bass_gain" default="0.5" style="left:483dp; top:1906dp; width:144dp; height:144dp;"/>
	<knob class="knob v-main v-shift" param="fx_treble" key="fx.treble_gain" default="0.5" style="left:653dp; top:1906dp; width:144dp; height:144dp;"/>
	<combo class="combo v-main v-shift" param="fx_drive" key="fx.drive" default="0.0" options="OFF, Soft, Hard" index="0" style="left:823dp; top:1906dp; width:130dp; height:40dp;"/>

	<!-- Mod FX -->
	<knob class="knob v-main v-shift" param="fx_mod_mix" key="fx.mod_mix" default="0.0" style="left:1051dp; top:1906dp; width:144dp; height:144dp;"/>
	<knob class="knob v-main v-shift" param="fx_mod_rate" key="fx.mod_rate" default="0.5" style="left:1221dp; top:1906dp; width:144dp; height:144dp;"/>
	<knob class="knob v-main v-shift" param="fx_mod_fb" key="fx.mod_feedback" default="0.0" style="left:1391dp; top:1906dp; width:144dp; height:144dp;"/>
	<combo class="combo v-main v-shift" param="fx_mod_type" key="fx.mod_effect" default="0.0" options="OFF, Chorus 1, Chorus 2, Chorus 3, Flanger 1, Flanger 2, Flanger 3, Phaser 1, Phaser 2, Phaser 3, Phaser 4, Super Chorus" index="0" style="left:1561dp; top:1906dp; width:216dp; height:40dp;"/>

	<!-- Delay -->
	<knob class="knob v-main v-shift" param="fx_dly_time" key="fx.delay_time" default="0.5" style="left:1874dp; top:1906dp; width:144dp; height:144dp;"/>
	<knob class="knob v-main v-shift" param="fx_dly_mix" key="fx.delay_mix" default="0.0" style="left:2044dp; top:1906dp; width:144dp; height:144dp;"/>
	<knob class="knob v-main v-shift" param="fx_dly_fb" key="fx.delay_feedback" default="0.0" style="left:2214dp; top:1906dp; width:144dp; height:144dp;"/>
	<combo class="combo v-main v-shift" param="fx_dly_type" key="fx.delay_effect" default="0.0" options="OFF, Mono Short, Mono Long, Pan L>R, Pan R>L, Pan Stereo" index="0" style="left:2384dp; top:1906dp; width:201dp; height:40dp;"/>
	<combo class="combo v-main v-shift" param="dly_sync" key="fx.delay_sync" default="0.0" options="Free, 4 Bars, 2 Bars, 1 Bar, 1/2, 1/4, 1/8, 1/16, 1/32, 1/4T, 1/8T, 1/16T" index="0" style="left:2633dp; top:1906dp; width:143dp; height:40dp;"/>

	<!-- Output Mix -->
	<knob class="knob v-main v-shift" param="fx_dry" key="fx.dry_mix" default="1.0" style="left:2873dp; top:1906dp; width:144dp; height:144dp;"/>
	<knob class="knob v-main v-shift" param="fx_jpfx" key="fx.jpfx_mix" default="1.0" style="left:3043dp; top:1906dp; width:144dp; height:144dp;"/>
	<knob class="knob v-main v-shift" param="master_volume" key="master.volume" default="0.8" style="left:3213dp; top:1906dp; width:144dp; height:144dp;"/>

	<!-- Reverb -->
	<knob class="knob v-reverb" param="fx_rv_size" key="reverb.size" default="0.0" style="left:66dp; top:1906dp; width:144dp; height:144dp;"/>
	<knob class="knob v-reverb" param="fx_rv_damp" key="reverb.damp" default="0.0" style="left:236dp; top:1906dp; width:144dp; height:144dp;"/>
	<knob class="knob v-reverb" param="fx_rv_lodamp" key="reverb.lodamp" default="0.0" style="left:406dp; top:1906dp; width:144dp; height:144dp;"/>
	<knob class="knob v-reverb" param="fx_rv_mix" key="reverb.mix" default="0.0" style="left:576dp; top:1906dp; width:144dp; height:144dp;"/>
	<toggle class="toggle v-reverb" param="fx_rv_bypass" key="reverb.bypass" default="0.0" style="left:746dp; top:1906dp; width:96dp; height:72dp;"/>
	<knob class="knob v-reverb" param="fx_rv_shimmer" key="reverb.shimmer" default="0.0" style="left:876dp; top:1906dp; width:144dp; height:144dp;"/>
	<knob class="knob v-reverb" param="fx_rv_lp" key="reverb.lowpass" default="0.0" style="left:1046dp; top:1906dp; width:144dp; height:144dp;"/>
	<knob class="knob v-reverb" param="fx_rv_hp" key="reverb.hipass" default="0.0" style="left:1216dp; top:1906dp; width:144dp; height:144dp;"/>
	<toggle class="toggle v-reverb" param="fx_rv_freeze" key="reverb.freeze" default="0.0" style="left:1386dp; top:1906dp; width:96dp; height:72dp;"/>

	<!-- Step Sequencer -->
	<knob class="knob v-seq" param="seq_steps" key="seq.steps" default="0.5333" style="left:66dp; top:1906dp; width:144dp; height:144dp;"/>
	<knob class="knob v-seq" param="seq_gate" key="seq.gate_length" default="0.5" style="left:236dp; top:1906dp; width:144dp; height:144dp;"/>
	<knob class="knob v-seq" param="seq_slide" key="seq.slide" default="0.0" style="left:406dp; top:1906dp; width:144dp; height:144dp;"/>
	<toggle class="toggle v-seq" param="seq_enable" key="seq.enable" default="0.0" style="left:576dp; top:1906dp; width:96dp; height:72dp;"/>
	<knob class="knob v-seq" param="seq_depth" key="seq.depth" default="0.5" style="left:706dp; top:1906dp; width:144dp; height:144dp;"/>
	<toggle class="toggle v-seq" param="seq_retrigger" key="seq.retrigger" default="0.0" style="left:876dp; top:1906dp; width:96dp; height:72dp;"/>
	<combo class="combo v-seq" param="seq_dir" key="seq.direction" default="0.0" options="Fwd, Rev, Bounce, Random" index="0" style="left:1019dp; top:1906dp; width:165dp; height:40dp;"/>
	<combo class="combo v-seq" param="seq_dest" key="seq.destination" default="0.0" options="None, Pitch, Filter, PWM, Amp" index="0" style="left:1232dp; top:1906dp; width:137dp; height:40dp;"/>
	<knob class="knob v-seq" param="seq_rate" key="seq.rate" default="0.5" style="left:1425dp; top:1906dp; width:144dp; height:144dp;"/>
	<combo class="combo v-seq" param="seq_sync" key="seq.timing_mode" default="0.0" options="Free, 4 Bars, 2 Bars, 1 Bar, 1/2, 1/4, 1/8, 1/16, 1/32, 1/4T, 1/8T, 1/16T" index="0" style="left:1595dp; top:1906dp; width:143dp; height:40dp;"/>
	<knob class="knob v-seq" param="seq_aux_depth" key="seq.aux_depth" default="0.5" style="left:1793dp; top:1906dp; width:144dp; height:144dp;"/>
	<combo class="combo v-seq" param="seq_aux_destination" key="seq.aux_destination" default="0.0" options="None, Filter, Pan, DelaySend, Drive" index="0" style="left:1963dp; top:1906dp; width:188dp; height:40dp;"/>
	<stepgrid class="stepgrid v-seq" param="" key="step_sequencer.pattern" lanes="2" steps="16" select="seq_step_sel,seq_aux_step_select" value="seq_step_sel,seq_aux_step_value" style="left:2206dp; top:1906dp; width:1440dp; height:171dp;"/>

	<!-- Arpeggiator -->
	<toggle class="toggle v-arp" param="arp_enable" key="arp.enable" default="0.0" style="left:66dp; top:1906dp; width:96dp; height:72dp;"/>
	<toggle class="toggle v-arp" param="arp_latch" key="arp.latch" default="0.0" style="left:188dp; top:1906dp; width:96dp; height:72dp;"/>
	<combo class="combo v-arp" param="arp_mode" key="arp.mode" default="0.0" options="Up, Down, UpDn Inc, UpDn Exc, AsPlayed, Random, Chord" index="0" style="left:310dp; top:1906dp; width:176dp; height:40dp;"/>
	<combo class="combo v-arp" param="arp_octaves" key="arp.octaves" default="0.0" options="1, 2, 3, 4" index="0" style="left:534dp; top:1906dp; width:108dp; height:40dp;"/>
	<knob class="knob v-arp" param="arp_free" key="arp.free_hz" default="0.5" style="left:697dp; top:1906dp; width:144dp; height:144dp;"/>
	<knob class="knob v-arp" param="arp_gate" key="arp.gate_length" default="0.5" style="left:867dp; top:1906dp; width:144dp; height:144dp;"/>
	<knob class="knob v-arp" param="arp_swing" key="arp.swing" default="0.5" style="left:1037dp; top:1906dp; width:144dp; height:144dp;"/>
	<combo class="combo v-arp" param="arp_rate" key="arp.rate" default="0.6364" options="Free, 4 Bars, 2 Bars, 1 Bar, 1/2, 1/4, 1/8, 1/16, 1/32, 1/4T, 1/8T, 1/16T" index="7" style="left:1207dp; top:1906dp; width:143dp; height:40dp;"/>
	<knob class="knob v-arp" param="arp_steps" key="arp.step_count" default="1.0" style="left:1397dp; top:1906dp; width:144dp; height:144dp;"/>
	<stepgrid class="stepgrid v-arp" param="" key="arpeggiator.pattern" lanes="1" steps="16" select="arp_grid" value="arp_grid" style="left:1575dp; top:1906dp; width:1980dp; height:180dp;"/>

	<!-- Setup -->
	<combo class="combo v-setup" param="perf_mode" key="perf.mode" default="0.0" options="Single, Layer, Split" index="0" style="left:66dp; top:1906dp; width:141dp; height:40dp;"/>
	<combo class="combo v-setup" param="perf_edit_target" key="perf.edit_target" default="0.0" options="A, B, Both" index="0" style="left:254dp; top:1906dp; width:129dp; height:40dp;"/>
	<combo class="combo v-setup" param="perf_midi_ch_a" key="perf.midi_channel_a" default="0.0" options="Ch 1, Ch 2, Ch 3, Ch 4, Ch 5, Ch 6, Ch 7, Ch 8, Ch 9, Ch 10, Ch 11, Ch 12, Ch 13, Ch 14, Ch 15, Ch 16" index="0" style="left:431dp; top:1906dp; width:137dp; height:40dp;"/>
	<combo class="combo v-setup" param="perf_midi_ch_b" key="perf.midi_channel_b" default="0.0667" options="Ch 1, Ch 2, Ch 3, Ch 4, Ch 5, Ch 6, Ch 7, Ch 8, Ch 9, Ch 10, Ch 11, Ch 12, Ch 13, Ch 14, Ch 15, Ch 16" index="1" style="left:632dp; top:1906dp; width:137dp; height:40dp;"/>
	<knob class="knob v-setup" param="perf_split_note" key="perf.split_note" default="0.4724" style="left:840dp; top:1906dp; width:144dp; height:144dp;"/>
	<combo class="combo v-setup" param="perf_voice_split" key="perf.voice_split" default="0.5" options="1+7, 2+6, 3+5, 4+4, 5+3, 6+2, 7+1" index="3" style="left:1010dp; top:1906dp; width:117dp; height:40dp;"/>
	<combo class="combo v-setup" param="perf_balance" key="perf.balance" default="0.5" options="A, AB, B" index="1" style="left:1175dp; top:1906dp; width:109dp; height:40dp;"/>
	<knob class="knob v-setup" param="glide_time" key="glide.time" default="0.0" style="left:1340dp; top:1906dp; width:144dp; height:144dp;"/>
	<toggle class="toggle v-setup" param="glide_on" key="glide.enable" default="0.0" style="left:1510dp; top:1906dp; width:96dp; height:72dp;"/>
	<knob class="knob v-setup" param="uni_det" key="voice.unison_detune" default="0.0" style="left:1640dp; top:1906dp; width:144dp; height:144dp;"/>
	<combo class="combo v-setup" param="poly_mode" key="voice.poly_mode" default="0.0" options="Poly, Mono, Unison" index="0" style="left:1810dp; top:1906dp; width:152dp; height:40dp;"/>
	<knob class="knob v-setup" param="bend_range" key="voice.bend_range" default="0.0833" style="left:2017dp; top:1906dp; width:144dp; height:144dp;"/>
	<knob class="knob v-setup" param="amp_level" key="voice.amp_level" default="1.0" style="left:2187dp; top:1906dp; width:144dp; height:144dp;"/>
	<knob class="knob v-setup" param="bpm_tempo" key="clock.tempo" default="0.5" style="left:2365dp; top:1906dp; width:144dp; height:144dp;"/>
	<combo class="combo v-setup" param="bpm_src" key="clock.clock_source" default="0.0" options="Internal, Ext MIDI" index="0" style="left:2535dp; top:1906dp; width:168dp; height:40dp;"/>
	<knob class="knob v-setup" param="vel_amp" key="velocity.amp_sens" default="0.0" style="left:2758dp; top:1906dp; width:144dp; height:144dp;"/>
	<knob class="knob v-setup" param="vel_flt" key="velocity.filter_sens" default="0.0" style="left:2928dp; top:1906dp; width:144dp; height:144dp;"/>
	<knob class="knob v-setup" param="vel_env" key="velocity.env_sens" default="0.0" style="left:3098dp; top:1906dp; width:144dp; height:144dp;"/>

</body>
</rml>
