	<!-- LFO 1 -->
	<div class="sectitle v-main v-shift v-reverb v-seq v-arp v-setup" style="left:1891dp; top:1177dp; width:876dp; text-align:center;">LFO 1</div>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:1917dp; top:1254dp; width:144dp; text-align:center;">FREQ</div>
