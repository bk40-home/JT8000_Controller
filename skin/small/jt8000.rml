<rml>
<head>
	<title>JT-8000</title>
	<link type="text/rcss" href="jt8000.rcss"/>
</head>
<body class="main">

	<div class="band"/>

	<div class="lcd1" id="lcd1" style="left:544dp; top:102dp; width:740dp; text-align:left;">INIT PATCH</div>
	<div class="lcd2" id="lcd2" style="left:544dp; top:184dp; width:932dp; text-align:left;"></div>

	<!-- Oscillator 1 -->
	<div class="sectitle v-main v-shift v-reverb v-seq v-arp v-setup" style="left:40dp; top:327dp; width:1000dp; text-align:center;">OSCILLATOR 1</div>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:83dp; top:345dp; width:420dp; text-align:left;">WAVE</div>
	<combo class="combo v-main v-shift v-reverb v-seq v-arp v-setup" param="osc1_wave" key="osc1.wave" default="0.0" options="SIN, SAW, SQR, TRI, ARB, PLS, rSAW, S&amp;H, vTRI, BLS, rBLS, BLSQ, BLP, SSAW" index="0" style="left:83dp; top:375dp; width:420dp; height:80dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:83dp; top:437dp; width:180dp; text-align:left;">OCTAVE</div>
	<combo class="combo v-main v-shift v-reverb v-seq v-arp v-setup" param="osc1_pitch" key="osc1.pitch_offset" default="0.5" options="-24, -12, 0, +12, +24" index="0" style="left:83dp; top:467dp; width:180dp; height:73dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:295dp; top:437dp; width:144dp; text-align:center;">DETUNE</div>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="osc1_detune" key="osc1.detune" default="0.5" style="left:295dp; top:467dp; width:144dp; height:174dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:508dp; top:437dp; width:144dp; text-align:center;">SS DETUNE</div>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="osc1_ss_det" key="osc1.supersaw_detune" default="0.0" style="left:508dp; top:467dp; width:144dp; height:174dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:720dp; top:437dp; width:144dp; text-align:center;">SS MIX</div>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="osc1_ss_mix" key="osc1.supersaw_mix" default="0.5" style="left:720dp; top:467dp; width:144dp; height:174dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:1188dp; top:384dp; width:144dp; text-align:center;">X-MOD</div>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="xmod_depth" key="mix.cross_mod" default="0.0" style="left:1188dp; top:414dp; width:144dp; height:174dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:83dp; top:529dp; width:180dp; text-align:left;">MOD DEST</div>
	<combo class="combo v-main v-shift v-reverb v-seq v-arp v-setup" param="pitch_mod_dest" key="mix.pitch_mod_dest" default="0.0" options="OSC1+2, OSC2, X-MOD" index="0" style="left:83dp; top:559dp; width:180dp; height:75dp;"/>

	<!-- Oscillator 2 -->
	<div class="sectitle v-main v-shift v-reverb v-seq v-arp v-setup" style="left:40dp; top:718dp; width:1000dp; text-align:center;">OSCILLATOR 2</div>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:83dp; top:740dp; width:420dp; text-align:left;">WAVE</div>
	<combo class="combo v-main v-shift v-reverb v-seq v-arp v-setup" param="osc2_wave" key="osc2.wave" default="0.0" options="SIN, SAW, SQR, TRI, ARB, PLS, rSAW, S&amp;H, vTRI, BLS, rBLS, BLSQ, BLP, SSAW" index="0" style="left:83dp; top:770dp; width:420dp; height:80dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:83dp; top:832dp; width:180dp; text-align:left;">OCTAVE</div>
	<combo class="combo v-main v-shift v-reverb v-seq v-arp v-setup" param="osc2_pitch" key="osc2.pitch_offset" default="0.5" options="-24, -12, 0, +12, +24" index="0" style="left:83dp; top:862dp; width:180dp; height:73dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:295dp; top:832dp; width:144dp; text-align:center;">DETUNE</div>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="osc2_detune" key="osc2.detune" default="0.5" style="left:295dp; top:862dp; width:144dp; height:174dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:508dp; top:832dp; width:144dp; text-align:center;">SS DETUNE</div>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="osc2_ss_det" key="osc2.supersaw_detune" default="0.0" style="left:508dp; top:862dp; width:144dp; height:174dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:720dp; top:832dp; width:144dp; text-align:center;">SS MIX</div>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="osc2_ss_mix" key="osc2.supersaw_mix" default="0.5" style="left:720dp; top:862dp; width:144dp; height:174dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:83dp; top:924dp; width:180dp; text-align:left;">OSC SYNC</div>
	<toggle class="toggle v-main v-shift v-reverb v-seq v-arp v-setup" param="osc_sync" key="mix.osc_sync" default="0.0" style="left:83dp; top:954dp; width:180dp; height:75dp;"/>

	<!-- Mixer -->
	<div class="sectitle v-main v-shift v-reverb v-seq v-arp v-setup" style="left:1400dp; top:327dp; width:300dp; text-align:center;">MIXER</div>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:1485dp; top:384dp; width:137dp; text-align:center;">BALANCE</div>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="osc_bal" key="mix.balance" default="0.5" style="left:1485dp; top:414dp; width:137dp; height:174dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:1485dp; top:844dp; width:142dp; text-align:center;">SUB</div>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="sub_mix" key="mix.sub" default="0.0" style="left:1485dp; top:874dp; width:142dp; height:174dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:1485dp; top:614dp; width:142dp; text-align:center;">Ring 1 Mix</div>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="osc1_ring" key="osc1.ring_mix" default="0.0" style="left:1485dp; top:644dp; width:142dp; height:174dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:1188dp; top:614dp; width:142dp; text-align:center;">Osc1 FB Amt</div>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="osc1_fb_amt" key="osc1.feedback_amount" default="0.0" style="left:1188dp; top:644dp; width:142dp; height:174dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:1188dp; top:844dp; width:144dp; text-align:center;">Osc1 FB Mix</div>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="osc1_fb_mix" key="osc1.feedback_mix" default="0.0" style="left:1188dp; top:874dp; width:144dp; height:174dp;"/>

	<!-- FILTER -->
	<div class="sectitle v-main v-shift v-reverb v-seq v-arp v-setup" style="left:1740dp; top:327dp; width:600dp; text-align:center;">FILTER</div>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:1825dp; top:384dp; width:145dp; text-align:center;">CUTOFF</div>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="flt_cut" key="filter.cutoff" default="1.0" style="left:1825dp; top:414dp; width:145dp; height:172dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:2038dp; top:384dp; width:144dp; text-align:center;">RESO</div>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="flt_res" key="filter.resonance" default="0.0" style="left:2038dp; top:414dp; width:144dp; height:172dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:1825dp; top:614dp; width:144dp; text-align:center;">OCT CTRL</div>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="flt_oct" key="filter.octave_control" default="0.4" style="left:1825dp; top:644dp; width:144dp; height:172dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:2038dp; top:660dp; width:144dp; text-align:left;">OBX/VAF</div>
	<toggle class="toggle v-main v-shift v-reverb v-seq v-arp v-setup" param="flt_engine" key="filter.engine" default="0.0" style="left:2038dp; top:690dp; width:144dp; height:75dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:1825dp; top:844dp; width:240dp; text-align:left;">MODE</div>
	<combo class="combo v-main v-shift v-reverb v-seq v-arp v-setup" param="flt_mode" key="filter.mode" default="0.0" options="4-Pole, 2-Pole, 2P BP, 2P Push, Xpander, Xpander M" index="0" style="left:1825dp; top:874dp; width:240dp; height:75dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:1825dp; top:936dp; width:240dp; text-align:left;">VA TYPE</div>
	<combo class="combo v-main v-shift v-reverb v-seq v-arp v-setup" param="flt_xp" key="filter.obxa_xpander_mode" default="0.0" options="SVF LP2, SVF HP2, SVF BP2, SVF NOTCH, SVF AP, Moog LP4, Moog LP2, Moog BP2, Diode LP4, Korg35 LP, Korg35 HP, TPT1 LP, TPT1 HP, MoogDV LP4, MoogDV LP2, MoogDV HP4, MoogDV BP" index="0" style="left:1825dp; top:966dp; width:240dp; height:79dp;"/>

	<!-- Amp Envelope -->
	<div class="sectitle v-main v-shift v-reverb v-seq v-arp v-setup" style="left:40dp; top:1315dp; width:541dp; text-align:center;">AMP ENVELOPE</div>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:185dp; top:1407dp; width:62dp; text-align:center;">ATT</div>
	<fader class="fader v-main v-shift v-reverb v-seq v-arp v-setup" param="env_amp_attack" key="env_amp.attack" default="0.0" style="left:185dp; top:1437dp; width:62dp; height:286dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:273dp; top:1407dp; width:63dp; text-align:center;">DEC</div>
	<fader class="fader v-main v-shift v-reverb v-seq v-arp v-setup" param="env_amp_decay" key="env_amp.decay" default="0.0" style="left:273dp; top:1437dp; width:63dp; height:286dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:362dp; top:1407dp; width:62dp; text-align:center;">SUS</div>
	<fader class="fader v-main v-shift v-reverb v-seq v-arp v-setup" param="env_amp_sustain" key="env_amp.sustain" default="0.0" style="left:362dp; top:1437dp; width:62dp; height:286dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:450dp; top:1407dp; width:62dp; text-align:center;">REL</div>
	<fader class="fader v-main v-shift v-reverb v-seq v-arp v-setup" param="env_amp_release" key="env_amp.release" default="0.0" style="left:450dp; top:1437dp; width:62dp; height:286dp;"/>

	<!-- Filter Envelope -->
	<div class="sectitle v-main v-shift v-reverb v-seq v-arp v-setup" style="left:745dp; top:1315dp; width:549dp; text-align:center;">FILTER ENVELOPE</div>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:769dp; top:1407dp; width:62dp; text-align:center;">ATT</div>
	<fader class="fader v-main v-shift v-reverb v-seq v-arp v-setup" param="env_filter_attack" key="env_filter.attack" default="0.0" style="left:769dp; top:1437dp; width:62dp; height:286dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:857dp; top:1407dp; width:63dp; text-align:center;">DEC</div>
	<fader class="fader v-main v-shift v-reverb v-seq v-arp v-setup" param="env_filter_decay" key="env_filter.decay" default="0.0" style="left:857dp; top:1437dp; width:63dp; height:286dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:946dp; top:1407dp; width:62dp; text-align:center;">SUS</div>
	<fader class="fader v-main v-shift v-reverb v-seq v-arp v-setup" param="env_filter_sustain" key="env_filter.sustain" default="0.0" style="left:946dp; top:1437dp; width:62dp; height:286dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:1034dp; top:1407dp; width:62dp; text-align:center;">REL</div>
	<fader class="fader v-main v-shift v-reverb v-seq v-arp v-setup" param="env_filter_release" key="env_filter.release" default="0.0" style="left:1034dp; top:1437dp; width:62dp; height:286dp;"/>

	<!-- Pitch Envelope -->
	<div class="sectitle v-main v-shift v-reverb v-seq v-arp v-setup" style="left:1289dp; top:1315dp; width:549dp; text-align:center;">PITCH ENVELOPE</div>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:1341dp; top:1407dp; width:62dp; text-align:center;">ATT</div>
	<fader class="fader v-main v-shift v-reverb v-seq v-arp v-setup" param="env_pitch_attack" key="env_pitch.attack" default="0.0" style="left:1341dp; top:1437dp; width:62dp; height:286dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:1429dp; top:1407dp; width:63dp; text-align:center;">DEC</div>
	<fader class="fader v-main v-shift v-reverb v-seq v-arp v-setup" param="env_pitch_decay" key="env_pitch.decay" default="0.0" style="left:1429dp; top:1437dp; width:63dp; height:286dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:1518dp; top:1407dp; width:62dp; text-align:center;">SUS</div>
	<fader class="fader v-main v-shift v-reverb v-seq v-arp v-setup" param="env_pitch_sustain" key="env_pitch.sustain" default="0.0" style="left:1518dp; top:1437dp; width:62dp; height:286dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:1606dp; top:1407dp; width:62dp; text-align:center;">REL</div>
	<fader class="fader v-main v-shift v-reverb v-seq v-arp v-setup" param="env_pitch_release" key="env_pitch.release" default="0.0" style="left:1606dp; top:1437dp; width:62dp; height:286dp;"/>

	<!-- LFO 1/2 -->
	<div class="sectitle v-main v-shift v-reverb v-seq v-arp v-setup" style="left:2378dp; top:327dp; width:1200dp; text-align:center;">LFO 1/2</div>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:2675dp; top:384dp; width:149dp; text-align:center;">FREQ</div>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="l1_freq" key="lfo1.freq" default="0.0" style="left:2675dp; top:414dp; width:149dp; height:174dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:2463dp; top:384dp; width:176dp; text-align:left;">WAVEFORM</div>
	<combo class="combo v-main v-shift v-reverb v-seq v-arp v-setup" param="l1_wave" key="lfo1.waveform" default="0.0" options="SIN, TRI, SAW, SQR, S&amp;H, NOISE" index="0" style="left:2463dp; top:414dp; width:176dp; height:94dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:2463dp; top:568dp; width:144dp; text-align:center;">PITCH</div>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="l1_p_dep" key="lfo1.pitch_depth" default="0.0" style="left:2463dp; top:598dp; width:144dp; height:174dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:2675dp; top:568dp; width:144dp; text-align:center;">FILTER</div>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="l1_f_dep" key="lfo1.filter_depth" default="0.0" style="left:2675dp; top:598dp; width:144dp; height:174dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:2888dp; top:568dp; width:144dp; text-align:center;">SHAPE</div>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="l1_w_dep" key="lfo1.pwm_depth" default="0.0" style="left:2888dp; top:598dp; width:144dp; height:174dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:3100dp; top:568dp; width:144dp; text-align:center;">AMP</div>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="l1_a_dep" key="lfo1.amp_depth" default="0.0" style="left:3100dp; top:598dp; width:144dp; height:174dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:2888dp; top:384dp; width:144dp; text-align:center;">DELAY</div>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="l1_delay" key="lfo1.delay" default="0.0" style="left:2888dp; top:414dp; width:144dp; height:174dp;"/>

	<!-- EQ &amp; Drive -->
	<div class="sectitle v-main v-shift v-reverb v-seq v-arp v-setup" style="left:2845dp; top:1155dp; width:562dp; text-align:center;">EQ &amp; DRIVE</div>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:2888dp; top:1212dp; width:144dp; text-align:center;">BASS</div>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="fx_bass" key="fx.bass_gain" default="0.5" style="left:2888dp; top:1242dp; width:144dp; height:174dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:3058dp; top:1212dp; width:144dp; text-align:center;">TREBLE</div>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="fx_treble" key="fx.treble_gain" default="0.5" style="left:3058dp; top:1242dp; width:144dp; height:174dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:3228dp; top:1212dp; width:152dp; text-align:left;">DRIVE</div>
	<combo class="combo v-main v-shift v-reverb v-seq v-arp v-setup" param="fx_drive" key="fx.drive" default="0.0" options="OFF, Soft, Hard" index="0" style="left:3228dp; top:1242dp; width:152dp; height:71dp;"/>

	<!-- Delay -->
	<div class="sectitle v-main v-shift v-reverb v-seq v-arp v-setup" style="left:1848dp; top:1769dp; width:975dp; text-align:center;">DELAY</div>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:1874dp; top:1846dp; width:144dp; text-align:center;">TIME</div>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="fx_dly_time" key="fx.delay_time" default="0.5" style="left:1874dp; top:1876dp; width:144dp; height:174dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:2038dp; top:1856dp; width:144dp; text-align:center;">MIX</div>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="fx_dly_mix" key="fx.delay_mix" default="0.0" style="left:2038dp; top:1886dp; width:144dp; height:174dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:2208dp; top:1856dp; width:144dp; text-align:center;">FEEDBACK</div>
	<knob class="knob v-main v-shift v-reverb v-seq v-arp v-setup" param="fx_DELAY" key="fx.DELAY" default="0.0" style="left:2208dp; top:1886dp; width:144dp; height:174dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:2384dp; top:1846dp; width:223dp; text-align:left;">TYPE</div>
	<combo class="combo v-main v-shift v-reverb v-seq v-arp v-setup" param="fx_delay_effect" key="fx.delay_effect" default="0.0" options="OFF, Mono Short, Mono Long, Pan L&gt;R, Pan R&gt;L, Pan Stereo" index="0" style="left:2384dp; top:1876dp; width:223dp; height:71dp;"/>
	<div class="legend v-main v-shift v-reverb v-seq v-arp v-setup" style="left:2633dp; top:1846dp; width:164dp; text-align:left;">SYNC</div>
	<combo class="combo v-main v-shift v-reverb v-seq v-arp v-setup" param="dly_sync" key="fx.delay_sync" default="0.0" options="Free, 4 Bars, 2 Bars, 1 Bar, 1/2, 1/4, 1/8, 1/16, 1/32, 1/4T, 1/8T, 1/16T" index="0" style="left:2633dp; top:1876dp; width:164dp; height:71dp;"/>

